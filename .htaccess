# BEGIN IWORKS PRIVATE FILE PROTECTION
# Required on BOTH the public and portal Apache document roots.
# Restrict direct HTTP access even when the path points to an existing file.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(?:database\.sql|(?:\.env(?:\..*)?|composer\.(?:json|lock)|phpunit\.xml|.*\.(?:bak|backup|sql|sqlite|log|lock|ini)))$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:storage|app|tests|scripts)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:database\.sql|\.env(?:\..*)?|.*\.(?:sql|sqlite|bak|backup|log|lock|ini))$ - [F,L,NC]
</IfModule>
# END IWORKS PRIVATE FILE PROTECTION

DirectoryIndex index.php

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
# Search engine discovery endpoints.
RewriteRule ^sitemap\.xml$ index.php?page=seo_sitemap [L,QSA]
RewriteRule ^robots\.txt$ index.php?page=seo_robots [L,QSA]
RewriteRule ^index\.html$ index.php?page=home [R=302,L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>
